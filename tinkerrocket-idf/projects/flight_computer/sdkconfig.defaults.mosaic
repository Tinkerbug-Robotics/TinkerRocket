# The V9 flying a Septentrio mosaic-G5 (-DTR_GNSS_MOSAIC=1, CMakeLists.txt),
# applied on top of sdkconfig.defaults and sdkconfig.defaults.v9.
#
# The receiver streams ~66 kB/s at 2 Mbaud. At that rate the UART's 128-byte
# RX FIFO fills in 0.64 ms, and an interrupt that needs the flash cache waits
# out every flash write (NVS commits on the pad), so bytes would be lost
# whenever the FC writes its settings. With the ISR in IRAM it runs through
# them. IDF adds ESP_INTR_FLAG_IRAM to the driver's interrupt by itself.
CONFIG_UART_ISR_IN_IRAM=y
