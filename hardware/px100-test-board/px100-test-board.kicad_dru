(version 1)

# From px100-module (and the carrier before it). The RF class's 0.2 mm gap to the pour sets the 50 ohm coplanar
# line, so it is load-bearing; values need their unit: a bare number here silently disables the rule.
#
# PX100 (U1) is QFN-40 at 0.4 mm pitch with 0.22 mm lands: 0.18 mm between pads. LNA_IN1/LNA_IN2 (pins 40/37) are in
# the RF class for their width, so their pads and fan-out need a smaller allowance inside U1's courtyard.
(rule "PX100 QFN-40 pin fan-out"
	(layer "F.Cu")
	(constraint clearance (min 0.15mm))
	(condition "A.Type != 'Zone' && B.Type != 'Zone' && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1')"))
