	(text "The exposed pad (41) is the chip's ONLY ground: give it a solid, short path (see FABRICATION-NOTES)."
		(exclude_from_sim no)
		(at 226.06 198.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0935d517-73b8-41fc-9e15-c5b176798b65")
	)
	(text "Reset RC (R12/C56), BOOT_SEL high = boot from flash (R13), UART idle-high pull-ups (R14/R15)."
		(exclude_from_sim no)
		(at 25.4 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "26e898eb-923e-4bee-9e00-4ecfa4b879aa")
	)
	(text "Stage 2, SkyTraq's split: lumped Wilkinson L10/L11 6.8 nH, C34/C35 1.5 pF, R10 100 ohm, C33 2.7 pF (centred on L1).\nFL6 is 50 ohm with no matching; FL7 (Murata) needs its 10 nH input shunt (L12).\nC36+L14 and C37+L15 are SkyTraq's input matches into the PX100 LNAs, which keep both LNA inputs free of any DC path.\nL13 (FL7's 6.8 nH output shunt) is NOT fitted: with L15 in series it would ground LNA_IN2 for DC.\nC37 is 1.3 pF, the same admittance at 1176.45 MHz as the reference 4 pF in parallel with 6.8 nH."
		(exclude_from_sim no)
		(at 130.48 102.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "845cc0e1-b635-4fd3-a61f-86c9daf35e42")
	)
	(text "Decoupling: each cap is drawn on the U1 pin (or VDD_RF pin pair) it serves; place it at that pin on the\nboard. C47 sits at Y1."
		(exclude_from_sim no)
		(at 25.4 241.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "95840228-0377-4b31-99e2-78fc63f096b2")
	)
	(text "Core: R11 5.1 ohm into the on-chip DC/DC, L16 2.2 uH to V_CORE, D7 Schottky clamp (DS p12)."
		(exclude_from_sim no)
		(at 25.4 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "98380050-2160-4667-b114-4f2ea40785c5")
	)
	(text "PX100-5C-01A (SkyTraq PX100 DS p12 reference), pins drawn in numerical order"
		(exclude_from_sim no)
		(at 160.02 116.84 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "a1513d27-f897-4b70-813d-0c8d2ceba644")
	)
	(text "Y1: Epson TG2520SMN 26 MHz, +/-0.5 ppm, fed by the\nPX100's own TCXO LDO (pin 3). Its long side is the\ng-sensitive X axis (0.4 ppb/g typ): keep it along board x,\nacross the thrust. C48 is a 0 ohm link: the TCXO drives TCXO_I\ndirectly, as in SkyTraq's reference (refit 1 nF if the clock fails).\nY2: 32.768 kHz, no load capacitors."
		(exclude_from_sim no)
		(at 110.49 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fc434aa1-1d30-4652-a361-1c5b15b24a9a")
	)
