		(property "Datasheet" ""
			(at 0 0 90)
			(layer "F.Fab")
			(hide yes)
			(uuid "80db2060-2304-460d-8c3b-1a0173c5ce00")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" "Battery temperature sense for the BQ21040 TS pin - 10 k NTC at 25 C, B25/85 = 3435 K, 0603. R53 (210 k, TS to GND) is TI's TTDM-defeat resistor. BOARD-MOUNTED, not on the cell: placed at the far end of the board from the charger, buck and ESP32-S3 so board self-heating biases the reading as little as possible. Consequence: the JEITA window tracks PCB temperature, so a cold cell in a self-heated board can still be charged - see the board README."
			(at 0 0 90)
