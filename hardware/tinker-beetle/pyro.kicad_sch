	(text "Current-limit trip: INA230 ALERT (open drain, low on a shunt over-limit) turns Q15 on and Q16 pulls U9's gate low."
		(exclude_from_sim no)
		(at 250.19 208.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2a4a9509-5078-4155-a1fb-4946e1e0be58")
	)
	(text "R139 2.2 k bounds Q16's current while tripped. ALERT is transparent (LEN = 0): it lets go once the current is gone,"
		(exclude_from_sim no)
		(at 250.19 210.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1ab992fa-2a96-40a2-967d-117629f3c3a5")
	)
	(text "and the out computer drops arm consent on the same over-limit. While armed, ALERT must carry SOL only (no conversion-ready pulses)."
		(exclude_from_sim no)
		(at 250.19 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fbed22f3-263b-41af-9204-b89b03edff78")
	)
