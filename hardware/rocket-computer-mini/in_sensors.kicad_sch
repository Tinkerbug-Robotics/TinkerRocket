	(text "Magnetometer is a FLIGHT sensor: it sits on the flight\ncomputer\\u0027s own MAG_SCL/MAG_SDA bus with the IMU, baro and\nGNSS, and shares their V_MCU_SWTCH rail. Its pull-ups (R117/\nR118) are on that SAME rail - do not move them to +3V3, and do\nnot put this part back on the out computer\\u0027s SEN_* bus: with\nthe pull-ups in one domain and the part in the other, U30\\u0027s\nQOD held its supply at ground while they drove its pads."
		(exclude_from_sim no)
		(at 15.24 57.785 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3a7c9e21-45bd-4f08-a913-77c1e0d5b8a2")
	)
