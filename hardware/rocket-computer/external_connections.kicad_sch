	(text "PYRO ARM (ported from the mini, corrections included) -- OFF-PAGE"
		(exclude_from_sim no)
		(at 310.0 130.0 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "feb98043-528a-5336-9c21-b5cfc5b87abc")
	)
	(text "Arming = square wave on ARM_CLK (P4 pad 17, ex-PYRO_ARM).  D12 anchors the pump"
		(exclude_from_sim no)
		(at 310.0 134.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0cc1cdab-9ac4-5401-8e2a-f7dc507e1228")
	)
	(text "to V_MCU_SWTCH (true doubler, ~6 V gate).  R21 relabeled: pump -> R21 -> U9 gate;"
		(exclude_from_sim no)
		(at 310.0 138.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "df66de1d-4dea-5ec8-8eee-3a7f76ce26b2")
	)
	(text "a static GPIO level can never arm.  V_CAP is GONE: FET sources + gate pulls now"
		(exclude_from_sim no)
		(at 310.0 142.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9fe3f5c1-92d8-59c1-b9eb-fde24a3989bb")
	)
	(text "ride VBAT_CON (pack-direct, upstream of the eFuse).  R20/C12 deleted."
		(exclude_from_sim no)
		(at 310.0 146.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "07521bb7-0e22-55cc-962f-496100d45f60")
	)
	(text "One-shot ceiling times ARM_GATE itself: R121 1M x C133 (0805) -> trip 1.5-3.3 s,"
		(exclude_from_sim no)
		(at 310.0 151.0 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cc2ec844-09f5-5680-aa2e-628a767c574d")
	)
	(text "then D15/R129 LATCH until the P4 domain power-cycles.  D14+R130 auto-reset on"
		(exclude_from_sim no)
		(at 310.0 155.0 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d25ac68d-f051-5f58-be42-30ad17d605e1")
	)
	(text "disarm; leave >= 0.5 s between ARM cycles."
		(exclude_from_sim no)
		(at 310.0 159.0 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
