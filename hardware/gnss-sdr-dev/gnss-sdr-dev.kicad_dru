(version 1)

# Clearances follow the Tinker-Mantis and live in Board Setup, as on the Space Bug M8T: 0.1 mm net-class clearance
# everywhere (the 0.35 mm-pitch P4, the 0.4 mm-pitch LNAs and the 0.8 mm-pitch BGA need nothing tighter), 0.09 mm
# minimum track, 0.1 mm hole clearance, 0.2 mm hole-to-hole and copper-to-edge. Every copper pour sets its own 0.2 mm
# clearance: that is the RF lines' ground gap, so it must not follow the net classes down.

# J101 is an edge-launch SMA: its centre and ground pads run to the board edge by design.
(rule "Edge-launch SMA pads meet the board edge"
	(constraint edge_clearance (min 0mm))
	(condition "A.memberOfFootprint('J101') || B.memberOfFootprint('J101')"))
