<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: the iOS app icon's blue sky, sampled from
  Assets.xcassets/AppIcon.appiconset/icon_image_v2_1024.png — a radial
  gradient measured at #80C8FE in the centre falling to #4291EF at the
  corners.  Vector, so it stays crisp under every launcher mask and
  density; the rocket-bug itself is the foreground layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76.37"
                android:startColor="#80C8FE"
                android:endColor="#4291EF" />
        </aapt:attr>
    </path>
</vector>
