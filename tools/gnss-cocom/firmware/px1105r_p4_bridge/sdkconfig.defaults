# The PX1105R board's ESP32-P4NRW32X is silicon v3.x, and the part number covers v3.0 and v3.1 alike (datasheet v0.7,
# section 1.3). IDF v6.0 defaults to a v3.1 minimum and would refuse a v3.0 chip, so the minimum is v3.0 here.
# Never set CONFIG_ESP32P4_SELECTS_REV_LESS_V3: that is Mantis's v1.3 configuration and does not run on v3.x.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_REV_MIN_300=y

# Boot flash U7 is a W25Q128JV (16 MB).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Console on USB-Serial-JTAG. It is also the only programming path once the board is mounted (no button), so the
# image keeps it alive. UART0 (GPIO37/38) stays unused.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1 kHz tick. At the IDF default of 100 Hz, pdMS_TO_TICKS(5) is zero and the copy loops spin (lc86_bridge hit this).
CONFIG_FREERTOS_HZ=1000

# Keep the byte stream clean: the host reads receiver output off this port.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Brown-out detector on (review S13); IDF's default level.
CONFIG_ESP_BROWNOUT_DET=y
